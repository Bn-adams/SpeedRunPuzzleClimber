<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/UIUSS.uss?fileID=7433441132597879392&amp;guid=1a401e8c1c65d0847b107e1238fc60a9&amp;type=3#UIUSS"/>
    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement style="flex-grow: 1; height: 15%; flex-direction: row; position: relative; width: 20%;">
            <ui:VisualElement style="flex-grow: 1; width: 10%; flex-direction: row;">
                <ui:VisualElement style="flex-grow: 1; width: 20%; flex-direction: row;">
                    <ui:Button text="Back" name="BackButton" focusable="false" class="MenuButtons" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(0, 0, 0, 0); padding-bottom: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: 100%; padding-top: 0; padding-right: 30%; padding-bottom: 35px; padding-left: 10%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 80%;">
            <ui:VisualElement style="flex-grow: 1;">
                <ui:Label text="General" name="Label" class="HeadingText"/>
                <ui:VisualElement name="Index1" class="SettingsFocused" style="flex-grow: 1; flex-direction: row;">
                    <ui:Toggle value="true" name="Checkbox1" focusable="false" class="CheckBox"/>
                    <ui:Label text="Controller Vibration" name="ControllerVibrationLable" class="GeneralText" style="-unity-text-align: middle-left;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Index2" style="flex-grow: 1; flex-direction: row;">
                    <ui:Toggle value="true" name="Checkbox2" focusable="false" class="CheckBox"/>
                    <ui:Label text="Flickering Lights" name="ControllerVibrationLable" class="GeneralText" style="-unity-text-align: middle-left;"/>
                </ui:VisualElement>
                <ui:Label text="Video" name="Label" class="HeadingText" style="-unity-font-style: bold;"/>
                <ui:VisualElement name="Index3" style="flex-grow: 1; flex-direction: row;">
                    <ui:Toggle value="true" name="Checkbox3" focusable="false" class="CheckBox"/>
                    <ui:Label text="Background" name="ControllerVibrationLable" class="GeneralText" style="-unity-text-align: middle-left;"/>
                </ui:VisualElement>
                <ui:Label text="Audio" class="HeadingText" style="-unity-font-style: bold;"/>
                <ui:Label text="Master" class="GeneralText"/>
                <ui:VisualElement name="Index4" style="flex-grow: 1; justify-content: center;">
                    <ui:Slider value="50" high-value="1" fill="true" name="VolumeSlider" inverted="false" low-value="0.0001" focusable="false" class="VolumeSlider"/>
                </ui:VisualElement>
                <ui:Label text="Music" name="MusicLable" class="GeneralText"/>
                <ui:VisualElement name="Index5" style="flex-grow: 1;">
                    <ui:Slider value="50" high-value="1" fill="true" name="MusicSlider" low-value="0.0001" focusable="false" class="VolumeSlider" style="display: flex;"/>
                </ui:VisualElement>
                <ui:Label text="Sound FX" name="SoundFXLabel" class="GeneralText"/>
                <ui:VisualElement name="Index6" style="flex-grow: 1;">
                    <ui:Slider name="SoundFXSlider" high-value="1" value="50" fill="true" low-value="0.0001" focusable="false" class="VolumeSlider" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                </ui:VisualElement>
                <ui:Label text="Danger" class="HeadingText" style="-unity-font-style: bold;"/>
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Button text="Delete Saved Data" name="DeleteSavedDataButton" focusable="false" class="MenuButtons" style="background-color: rgb(65, 6, 6); -unity-font-definition: url(&quot;project://database/Assets/Art/Fonts/vinizinho.ttf?fileID=12800000&amp;guid=04ddb951892d3f5419c041e0aa566efb&amp;type=3#vinizinho&quot;); font-size: 60px; color: rgb(255, 255, 255); border-top-left-radius: 26px; border-top-right-radius: 26px; border-bottom-right-radius: 26px; border-bottom-left-radius: 26px; -unity-text-outline-width: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
